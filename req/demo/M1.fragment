# M1 grade drift: per frame and channel, mean(out) - mean(ref) within [-4, 4] levels of 8-bit RGB
let s0 = where(t, eq("frame", "f0"))
claim difference(mean(s0, "out_r"), mean(s0, "ref_r"))
claim atmost(difference(mean(s0, "out_r"), mean(s0, "ref_r")), c = 4)
claim atleast(difference(mean(s0, "out_r"), mean(s0, "ref_r")), c = -4)
claim difference(mean(s0, "out_g"), mean(s0, "ref_g"))
claim atmost(difference(mean(s0, "out_g"), mean(s0, "ref_g")), c = 4)
claim atleast(difference(mean(s0, "out_g"), mean(s0, "ref_g")), c = -4)
claim difference(mean(s0, "out_b"), mean(s0, "ref_b"))
claim atmost(difference(mean(s0, "out_b"), mean(s0, "ref_b")), c = 4)
claim atleast(difference(mean(s0, "out_b"), mean(s0, "ref_b")), c = -4)
let s1 = where(t, eq("frame", "f1"))
claim difference(mean(s1, "out_r"), mean(s1, "ref_r"))
claim atmost(difference(mean(s1, "out_r"), mean(s1, "ref_r")), c = 4)
claim atleast(difference(mean(s1, "out_r"), mean(s1, "ref_r")), c = -4)
claim difference(mean(s1, "out_g"), mean(s1, "ref_g"))
claim atmost(difference(mean(s1, "out_g"), mean(s1, "ref_g")), c = 4)
claim atleast(difference(mean(s1, "out_g"), mean(s1, "ref_g")), c = -4)
claim difference(mean(s1, "out_b"), mean(s1, "ref_b"))
claim atmost(difference(mean(s1, "out_b"), mean(s1, "ref_b")), c = 4)
claim atleast(difference(mean(s1, "out_b"), mean(s1, "ref_b")), c = -4)
let s2 = where(t, eq("frame", "f2"))
claim difference(mean(s2, "out_r"), mean(s2, "ref_r"))
claim atmost(difference(mean(s2, "out_r"), mean(s2, "ref_r")), c = 4)
claim atleast(difference(mean(s2, "out_r"), mean(s2, "ref_r")), c = -4)
claim difference(mean(s2, "out_g"), mean(s2, "ref_g"))
claim atmost(difference(mean(s2, "out_g"), mean(s2, "ref_g")), c = 4)
claim atleast(difference(mean(s2, "out_g"), mean(s2, "ref_g")), c = -4)
claim difference(mean(s2, "out_b"), mean(s2, "ref_b"))
claim atmost(difference(mean(s2, "out_b"), mean(s2, "ref_b")), c = 4)
claim atleast(difference(mean(s2, "out_b"), mean(s2, "ref_b")), c = -4)
let s3 = where(t, eq("frame", "f3"))
claim difference(mean(s3, "out_r"), mean(s3, "ref_r"))
claim atmost(difference(mean(s3, "out_r"), mean(s3, "ref_r")), c = 4)
claim atleast(difference(mean(s3, "out_r"), mean(s3, "ref_r")), c = -4)
claim difference(mean(s3, "out_g"), mean(s3, "ref_g"))
claim atmost(difference(mean(s3, "out_g"), mean(s3, "ref_g")), c = 4)
claim atleast(difference(mean(s3, "out_g"), mean(s3, "ref_g")), c = -4)
claim difference(mean(s3, "out_b"), mean(s3, "ref_b"))
claim atmost(difference(mean(s3, "out_b"), mean(s3, "ref_b")), c = 4)
claim atleast(difference(mean(s3, "out_b"), mean(s3, "ref_b")), c = -4)
